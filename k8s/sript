1. start minikube
minikube start

2. add/update config
kubectl apply -f k8s/library-deployment.yaml

3. restart
kubectl rollout restart deployment library -n library-app	

4. delete
kubectl delete pod library-5cc7f5664c-f4jtw -n library-app
kubectl delete namespace library-app
kubectl get namespaces

5. Get discribe
kubectl describe pod pg-db-8597bf94f8-nl5z7 -n library-app

5. Get logs
kubectl logs -n library-app library-f8d68478c-b5mwz 

6. Get pods
kubectl get pods -n library-app

7. Ger service in to browser ( link )
minikube service library-service -n library-app
